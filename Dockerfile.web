FROM node:22-alpine AS build
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV API_URL=http://api:8000
RUN npm run build

FROM node:22-alpine
WORKDIR /web
ENV NODE_ENV=production API_URL=http://api:8000
COPY --from=build /web ./
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--port", "3000", "--hostname", "0.0.0.0"]
